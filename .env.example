# URL pública del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integración con miami_agenda. Los botones "Agendar" llevan a <URL>/cliente/agendar.
# La URL debe ser https:// (http:// solo en localhost); cualquier otro valor deja los botones deshabilitados.
# Desarrollo local: http://localhost:5173
NEXT_PUBLIC_BOOKING_ENABLED=false
NEXT_PUBLIC_EXTERNAL_BOOKING_URL=
# Slug del negocio en la agenda (opcional; vacío = negocio por defecto de la agenda)
NEXT_PUBLIC_BOOKING_BUSINESS=

# Backend (miami_web_backend). Si se define, el login con Google lo hace el backend y la
# sesión se comparte con la agenda; AUTH_GOOGLE_* y AUTH_SECRET quedan sin uso.
# https:// en producción (http:// solo en localhost).
# Es el origen del BACKEND (p. ej. https://miamiwebbackend-production.up.railway.app), no el de la
# landing: el navegador llama a /api/ en la propia landing y Next lo reenvía allí (next.config.mjs),
# así la cookie de sesión es de este dominio. En el backend: GOOGLE_CALLBACK_VIA_FRONTEND=True y
# en Google Cloud la URI de redirección https://<landing>/api/auth/google/callback/
NEXT_PUBLIC_API_URL=

# Google OAuth 2.0 (Opcional en desarrollo: si no se definen, se activa el selector interactivo de demostración)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_SECRET: mínimo 32 caracteres (p. ej. `openssl rand -base64 48`). Si es más corto, el login con Google queda deshabilitado.
AUTH_SECRET=
