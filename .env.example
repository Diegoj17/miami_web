# URL pública del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integración con el aplicativo externo de agendamiento (deshabilitado mientras se integra)
NEXT_PUBLIC_BOOKING_ENABLED=false
NEXT_PUBLIC_EXTERNAL_BOOKING_URL=

# Google OAuth 2.0 (Opcional en desarrollo: si no se definen, se activa el selector interactivo de demostración)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
